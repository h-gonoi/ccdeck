{
  "expo": {
    "name": "ccdeck",
    "slug": "ccdeck",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131311",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.ccdeck.mobile",
      "appleTeamId": "UVULXV8Z7Z"
    },
    "android": {
      "package": "dev.ccdeck.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#131311",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "セッションに添付する画像を選ぶために使います"
        }
      ]
    ]
  }
}
