#!/bin/zsh
# ccdeck — 複数の Claude Code / Codex セッションを束ねる軽量デッキ
set -e

ROOT="${0:A:h:h}"
PORT="${CCDECK_PORT:-7788}"
URL="http://127.0.0.1:${PORT}"
STATE_DIR="$HOME/.ccdeck"
LOG="$STATE_DIR/server.log"
PID_FILE="$STATE_DIR/server.pid"
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# メニューバーから起動した login shell は、普段のターミナルと別の Node を拾うことがある。
# native addon（node-pty）を npm install した Node と揃えるため、NVM の default を優先する。
NODE_BIN="${CCDECK_NODE:-}"
if [[ -z "$NODE_BIN" && -f "$HOME/.nvm/alias/default" ]]; then
  NODE_VERSION="$(<"$HOME/.nvm/alias/default")"
  NVM_NODE="$HOME/.nvm/versions/node/v${NODE_VERSION}/bin/node"
  [[ -x "$NVM_NODE" ]] && NODE_BIN="$NVM_NODE"
fi
[[ -n "$NODE_BIN" ]] || NODE_BIN="$(command -v node)"

# npm install した Node と、ここで使う Node が違うと node-pty が読めない。
# 分かりにくいエラーになるので、先に見比べて止める。
if [[ -f "$ROOT/node_modules/.ccdeck-node" ]]; then
  BUILT_WITH="$(<"$ROOT/node_modules/.ccdeck-node")"
  NOW="$("$NODE_BIN" -p 'process.versions.modules' 2>/dev/null || echo '?')"
  if [[ "$BUILT_WITH" != "$NOW" ]]; then
    echo "Node が食い違っています。" >&2
    echo "  npm install したとき: NODE_MODULE_VERSION $BUILT_WITH" >&2
    echo "  いま使う Node:        NODE_MODULE_VERSION $NOW ($NODE_BIN)" >&2
    echo "どちらかに揃えてください:" >&2
    echo "  同じ Node で入れ直す : rm -rf node_modules && npm install" >&2
    echo "  使う Node を指定する : CCDECK_NODE=/path/to/node ccdeck" >&2
    exit 1
  fi
fi

mkdir -p "$STATE_DIR"

# --lan: サーバーを LAN に出す。付けない限りループバックに閉じたまま。
# --force: stop のときに確認を飛ばす。
SERVER_ARGS=""
FORCE=0
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --lan) SERVER_ARGS="--lan" ;;
    --force|-f) FORCE=1 ;;
    *) ARGS+=("$arg") ;;
  esac
done
set -- "${ARGS[@]}"

alive() { curl -sf -o /dev/null --max-time 1 "$URL/api/sessions"; }

session_count() {
  curl -s --max-time 2 "$URL/api/sessions" \
    | python3 -c 'import json,sys; print(len(json.load(sys.stdin)))' 2>/dev/null || echo 0
}

start_server() {
  if alive; then return 0; fi
  # セッションを孫プロセスとして生かすため、親シェルから完全に切り離す
  (cd "$ROOT" && nohup "$NODE_BIN" server/index.js $SERVER_ARGS >>"$LOG" 2>&1 & echo $! >"$PID_FILE")
  for _ in {1..40}; do
    alive && return 0
    sleep 0.25
  done
  echo "サーバーが起動しませんでした。ログ: $LOG" >&2
  tail -5 "$LOG" >&2
  return 1
}

open_window() {
  if [[ ! -x "$CHROME" ]]; then
    echo "Chrome が見つかりません。ブラウザで $URL を開いてください。"
    return 0
  fi
  # --app はアドレスバーもタブもない独立ウィンドウ。既存 Chrome とプロセスを共有する。
  "$CHROME" --app="$URL" >/dev/null 2>&1 &
}

case "${1:-open}" in
  open)
    start_server && open_window
    echo "ccdeck → $URL"
    ;;
  start)
    start_server || exit 1
    if [[ -n "$SERVER_ARGS" ]]; then
      tail -4 "$LOG"
    else
      echo "サーバー起動: $URL"
    fi
    ;;
  stop)
    # 走っているセッションは道連れに死ぬ。黙って殺さず、本数を見せてから聞く。
    count=0
    # if で受ける。`alive && count=...` にすると、サーバーが止まっているときに
    # 文全体が失敗して set -e で抜け、PID ファイルの掃除まで届かない。
    if alive; then count=$(session_count); fi
    count=${count:-0}
    if [[ "$count" -gt 0 && "$FORCE" != 1 ]]; then
      echo "セッション ${count} 本が走っています。停止すると全部終了します。"
      echo "（次の start で、会話の続きから自動で復元します）"
      if [[ ! -t 0 ]]; then
        echo "対話端末ではないので停止しませんでした。承知の上なら: ccdeck stop --force" >&2
        exit 1
      fi
      if ! read -q "?本当に停止しますか？ [y/N] "; then
        echo
        echo "やめました"
        exit 1
      fi
      echo
    fi
    if [[ -f "$PID_FILE" ]]; then
      kill "$(cat "$PID_FILE")" 2>/dev/null || true
      rm -f "$PID_FILE"
    fi
    # 台帳を書き切る猶予を与えてから、取りこぼしを掃除する
    for _ in {1..20}; do
      alive || break
      sleep 0.1
    done
    # 起動は (cd "$ROOT" && node server/index.js) なので、コマンドラインに
    # ccdeck の文字は入らない。取り違えないよう、この ROOT の server/index.js を
    # 開いているプロセスだけを狙って落とす。
    for pid in $(pgrep -f "server/index.js" 2>/dev/null); do
      [[ "$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | tail -1)" == "n$ROOT" ]] && kill "$pid" 2>/dev/null
    done
    if [[ "$count" -gt 0 ]]; then
      echo "停止しました（セッション ${count} 本は次の start で復元します）"
    else
      echo "停止しました"
    fi
    ;;
  status)
    if alive; then
      echo "稼働中 · セッション $(session_count) 本 · $URL"
    else
      echo "停止中"
    fi
    ;;
  log) tail -f "$LOG" ;;
  *)
    echo "使い方: ccdeck [open|start|stop|status|log]"
    exit 1
    ;;
esac
